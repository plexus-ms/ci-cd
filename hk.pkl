amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    steps {
      ["check"] {
        glob = List(".github/workflows/*.yml")
        check = "mise :check"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["verify"] {
        check = "mise :verify"
      }
    }
  }
}
